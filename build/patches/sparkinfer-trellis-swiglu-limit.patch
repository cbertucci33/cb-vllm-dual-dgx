+@dsl_user_op
+def _clamp_swiglu_f32(gate, up, limit, *, loc=None, ip=None):
+    # Preserve FP32, subnormals and NaNs. A positive limit makes xorsign.abs
+    # clamp the up magnitude while retaining its sign (SM86+, including GB10).
+    limit_ir = cutlass.Float32(limit).ir_value(loc=loc, ip=ip)
+    gate = cutlass.Float32(
+        llvm.inline_asm(
+            T.f32(),
+            [cutlass.Float32(gate).ir_value(loc=loc, ip=ip), limit_ir],
+            "min.NaN.f32 $0, $1, $2;",
+            "=f,f,f",
+            has_side_effects=False,
+            is_align_stack=False,
+            asm_dialect=llvm.AsmDialect.AD_ATT,
+            loc=loc,
+            ip=ip,
+        )
+    )
+    up = cutlass.Float32(
+        llvm.inline_asm(
+            T.f32(),
+            [cutlass.Float32(up).ir_value(loc=loc, ip=ip), limit_ir],
+            "min.NaN.xorsign.abs.f32 $0, $1, $2;",
+            "=f,f,f",
+            has_side_effects=False,
+            is_align_stack=False,
+            asm_dialect=llvm.AsmDialect.AD_ATT,
+            loc=loc,
+            ip=ip,
+        )
+    )
+    return gate, up
+
