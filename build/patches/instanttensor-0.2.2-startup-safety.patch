--- /dev/null
+++ b/csrc/instant_tensor/cancellation.hpp
@@ -0,0 +1,30 @@
+#pragma once
+#include <atomic>
+#include <chrono>
+#include <cmath>
+#include <memory>
+#include <optional>
+#include <stdexcept>
+
+namespace instanttensor {
+class OperationControl {
+    using Clock = std::chrono::steady_clock;
+    std::optional<Clock::time_point> deadline;
+    std::atomic<bool> cancelled{false};
+public:
+    explicit OperationControl(std::optional<double> remaining = std::nullopt) {
+        if (!remaining) return;
+        if (!std::isfinite(*remaining) || *remaining <= 0)
+            throw std::runtime_error("InstantTensor startup deadline expired");
+        deadline = Clock::now() + std::chrono::duration_cast<Clock::duration>(
+            std::chrono::duration<double>(*remaining));
+    }
+    void cancel() { cancelled.store(true, std::memory_order_release); }
+    void check() const {
+        if (cancelled.load(std::memory_order_acquire))
+            throw std::runtime_error("InstantTensor operation cancelled");
+        if (deadline && Clock::now() >= *deadline)
+            throw std::runtime_error("InstantTensor startup deadline expired");
+    }
+};
+} // namespace instanttensor
