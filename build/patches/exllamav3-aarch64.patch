index 0000000..379645e
--- /dev/null
+++ b/exllamav3/exllamav3_ext/parallel/all_reduce_cpu_unsupported.cpp
@@ -0,0 +1,55 @@
+#include <stdexcept>
+
+#include "../avx2_target.h"
+#include "../avx512_target.h"
+#include "all_reduce_cpu_avx2.h"
+#include "all_reduce_cpu_avx512.h"
+
+bool is_avx2_supported()
+{
+    return false;
+}
+
+bool is_avx512_supported()
+{
+    return false;
+}
+
+void enable_fast_fp() {}
+void enable_fast_fp_avx2() {}
+void enable_fast_fp_avx512() {}
+
+[[noreturn]] static void unsupported_cpu_reduce()
+{
+    throw std::runtime_error(
+        "ExLlamaV3's native CPU all-reduce backend requires x86 AVX2"
+    );
+}
+
+void perform_cpu_reduce(
+    PGContext*, size_t, uint32_t, uint8_t*, size_t
+)
+{
+    unsupported_cpu_reduce();
+}
+
+void perform_cpu_reduce_avx2(
+    PGContext*, size_t, uint32_t, uint8_t*, size_t
+)
+{
+    unsupported_cpu_reduce();
+}
+
+void perform_cpu_reduce_avx512(
+    PGContext*, size_t, uint32_t, uint8_t*, size_t
+)
+{
+    unsupported_cpu_reduce();
+}
+
+void bf16_add_inplace_avx512(
+    uint16_t*, const uint16_t*, size_t
+)
+{
+    unsupported_cpu_reduce();
+}
