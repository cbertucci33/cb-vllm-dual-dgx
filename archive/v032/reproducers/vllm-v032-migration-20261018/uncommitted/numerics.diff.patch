+    )
+    bias = torch.full((num_experts,), other_bias, dtype=torch.float32, device="cuda")
+    bias[selected_ids] = torch.tensor(
+        selected_biases, dtype=torch.float32, device="cuda"
+    )
+    expected_values, expected_ids = _single_group_reference(
+        logits,
+        bias,
