+            delta_text, delta_token_ids, request, prompt_token_ids, finished=finished
+        )
+        if not self._legacy_json_tools or delta is None:
+            return delta
+        self._initialize_history_tool_call_cnt(request)
+        state = self._stream_state
+        tool_delta = None
+        if delta.content:
+            previous = state.previous_text
+            current = previous + delta.content
+            if request.tool_choice == "required":
+                tool_delta = self._required_json_delta(current)
+            else:
