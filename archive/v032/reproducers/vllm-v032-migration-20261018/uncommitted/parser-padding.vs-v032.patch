+            "THINK_END": config.terminals["THINK_END"],
+            "JSON_OBJECT_START": "{",
+            "JSON_ARRAY_START": "[",
+        },
+        token_id_terminals={
+            key: value
+            for key, value in config.token_id_terminals.items()
+            if key in ("THINK_START", "THINK_END")
+        },
+        transitions=transitions,
+        content_events={
