+def _required_json_calls(text: str) -> list[tuple[str | None, str | None]]:
+    """Find each envelope's name and raw (possibly unfinished) arguments."""
+    decoder = json.JSONDecoder()
+    calls: list[tuple[str | None, str | None]] = []
+
+    def skip_space(index: int) -> int:
+        while index < len(text) and text[index] in " \t\r\n":
+            index += 1
+        return index
+
+    cursor = skip_space(0)
+    if cursor == len(text) or text[cursor] != "[":
+        return calls
+    cursor += 1
+    while True:
+        cursor = skip_space(cursor)
+        if cursor == len(text) or text[cursor] != "{":
+            return calls
+        cursor += 1
+        name = arguments = None
+        calls.append((name, arguments))
+        while True:
+            cursor = skip_space(cursor)
+            if cursor == len(text):
+                return calls
+            if text[cursor] == "}":
+                cursor += 1
+                break
+            try:
+                key, cursor = decoder.raw_decode(text, cursor)
+            except json.JSONDecodeError:
+                return calls
+            if not isinstance(key, str):
+                return calls
+            cursor = skip_space(cursor)
+            if cursor == len(text) or text[cursor] != ":":
+                return calls
+            start = skip_space(cursor + 1)
+            if start == len(text):
+                return calls
+            end, complete = _json_value_end(text, start)
+            if key == "parameters":
+                arguments = text[start:end]
+            elif key == "name" and complete:
+                try:
+                    value = decoder.raw_decode(text, start)[0]
+                except json.JSONDecodeError:
+                    return calls
+                if isinstance(value, str):
+                    name = value
+            calls[-1] = (name, arguments)
+            if not complete:
+                return calls
+            cursor = skip_space(end)
+            if cursor == len(text):
+                return calls
+            if text[cursor] == "}":
+                cursor += 1
+                break
+            if text[cursor] != ",":
+                return calls
+            cursor += 1
+        cursor = skip_space(cursor)
+        if cursor == len(text) or text[cursor] != ",":
+            return calls
+        cursor += 1
