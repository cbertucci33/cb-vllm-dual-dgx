+class MiMoServingParser(DelegatingParser):
+    """Retain adapter request contracts, but parse MiMo in one state machine."""
+
+    def __init__(
+        self, tokenizer: TokenizerLike, tools: list[Tool] | None = None, **kwargs
+    ) -> None:
