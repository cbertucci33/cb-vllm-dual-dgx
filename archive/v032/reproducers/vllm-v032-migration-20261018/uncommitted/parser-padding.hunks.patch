+    cursor = skip_space(0)
+    if cursor == len(text) or text[cursor] != "[":
+        return calls
+    cursor += 1
+    while True:
+        cursor = skip_space(cursor)
+        if cursor == len(text) or text[cursor] != "{":
+            return calls
+        cursor += 1
+        name = arguments = None
+        calls.append((name, arguments))
