+                return calls
+            cursor = skip_space(end)
+            if cursor == len(text):
+                return calls
+            if text[cursor] == "}":
+                cursor += 1
+                break
+            if text[cursor] != ",":
+                return calls
+            cursor += 1
+        cursor = skip_space(cursor)
+        if cursor == len(text) or text[cursor] != ",":
+            return calls
+        cursor += 1
+
