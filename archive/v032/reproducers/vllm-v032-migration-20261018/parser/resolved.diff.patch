+        self._append(char)
+
+    def _append(self, char: str) -> None:
+        if self.reading_key or self.key == "name":
+            self.capture.append(char)
+        elif self.key == "parameters":
+            self.pending.append(char)
+
+    def _finish_value(self) -> None:
+        if self.reading_key or self.key == "name":
