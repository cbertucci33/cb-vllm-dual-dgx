+                elif self.state == "envelope" and char == "]":
+                    self.state = "done"
+                elif self.state == "key" and char == '"':
+                    self._begin_value(char, key=True)
+                elif self.state == "colon" and char == ":":
+                    self.state = "value_start"
+                elif self.state == "value_start":
