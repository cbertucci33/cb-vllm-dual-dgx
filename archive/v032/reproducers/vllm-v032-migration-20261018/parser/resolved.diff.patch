+            Glm47MoeParser(make_mock_tokenizer(VOCAB)), mock_request, _pieces(text, 7)
+        )
+        result = Glm47MoeParser(make_mock_tokenizer(VOCAB)).extract_tool_calls(
+            text, mock_request
