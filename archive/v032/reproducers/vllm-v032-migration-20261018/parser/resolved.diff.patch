+def test_prompt_boundary_does_not_copy_full_history(parser, tail, state):
+    """Only boundary discovery is tail-local; the full prompt stays available."""
+    from collections.abc import Sequence
+
+    class Prompt(Sequence):
+        def __init__(self):
+            self.reads = []
+
+        def __len__(self):
+            return 800_000
+
+        def __iter__(self):
+            raise AssertionError("Boundary discovery copied the full prompt")
+
+        def __getitem__(self, index):
+            if not isinstance(index, int) or not 0 <= index < len(self):
+                raise IndexError(index)
+            self.reads.append(index)
+            offset = index - (len(self) - len(tail))
+            return tail[offset] if offset >= 0 else TEXT
+
+    prompt = Prompt()
+    parser.adjust_initial_state_from_prompt(prompt)
+    assert parser._engine.state.name == state
+    assert prompt.reads
+    assert min(prompt.reads) >= len(prompt) - len(tail)
