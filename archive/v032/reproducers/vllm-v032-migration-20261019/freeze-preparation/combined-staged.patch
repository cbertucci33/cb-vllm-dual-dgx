+    assert api.kwargs["up_suh"].data_ptr() == slabs["w13_suh"][1].data_ptr()
+    assert api.kwargs["down_svh"].data_ptr() == slabs["w2_svh"].data_ptr()
+    assert api.kwargs["mcg"] is marker
