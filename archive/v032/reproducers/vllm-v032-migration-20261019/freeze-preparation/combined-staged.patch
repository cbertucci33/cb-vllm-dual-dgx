+def _finalize_loading(model):
+    from types import SimpleNamespace
+    from typing import cast
+
+    from vllm.config import ModelConfig
+    from vllm.model_executor.model_loader.utils import process_weights_after_loading
+
+    process_weights_after_loading(
+        model,
+        cast(
+            ModelConfig,
+            SimpleNamespace(
+                dtype=torch.float32,
+                quantization=None,
+                word_embeddings_untied_by_checkpoint=False,
+            ),
+        ),
+        torch.device("cpu"),
+    )
+
+
+def _empty_module(cls):
+    module = cls.__new__(cls)
+    torch.nn.Module.__init__(module)
+    return module
+
+
+def _minimal_loading_model(monkeypatch):
+    from types import SimpleNamespace
+
+    import vllm.model_executor.models.mimo_v2 as mimo_module
+
+    monkeypatch.setattr(mimo_module, "get_tensor_model_parallel_rank", lambda: 0)
+    monkeypatch.setattr(mimo_module, "get_tensor_model_parallel_world_size", lambda: 1)
+    model = _empty_module(mimo_module.MiMoV2FlashForCausalLM)
+    inner = mimo_module.MiMoV2Model.__new__(mimo_module.MiMoV2Model)
+    torch.nn.Module.__init__(inner)
+    inner.config = SimpleNamespace(num_key_value_heads=1)
+    monkeypatch.setattr(inner, "get_expert_mapping", lambda: [])
+    inner.layers = torch.nn.ModuleList([torch.nn.Module()])
+    attn = torch.nn.Module()
+    attn.total_num_heads = attn.total_num_kv_heads = 1
+    attn.head_dim = attn.v_head_dim = 128
+    attn.qkv_proj = torch.nn.Module()
+    attn.qkv_proj.weight = torch.nn.Parameter(
+        torch.zeros(384, 128, dtype=FP8_DTYPE), requires_grad=False
+    )
+    attn.qkv_proj.weight_scale_inv = torch.nn.Parameter(
+        torch.zeros(3, 1), requires_grad=False
+    )
+    inner.layers[0].self_attn = attn
+    model.model = inner
+    model.lm_head = torch.nn.Linear(1, 1, bias=False)
+    return model
+
+
+def test_fused_qkv_pair_survives_outer_loader_groups_and_complete_reload(monkeypatch):
+    model = _minimal_loading_model(monkeypatch)
+    prefix = "model.layers.0.self_attn.qkv_proj"
+    for value in [1.0, 2.0]:
+        weight = torch.full((384, 128), value).to(FP8_DTYPE)
+        scale = torch.full((3, 1), value)
+        loaded = model.load_weights(
+            [
+                (prefix + ".weight", weight),
+                ("lm_head.weight", torch.ones(1, 1)),
+                (prefix + ".weight_scale_inv", scale),
+            ]
+        )
+        _finalize_loading(model)
+        assert {prefix + ".weight", prefix + ".weight_scale_inv"} <= loaded
+        assert not model.model._pending_fp8_qkv_proj
+        torch.testing.assert_close(
+            model.model.layers[0].self_attn.qkv_proj.weight.float(), weight.float()
+        )
+        torch.testing.assert_close(
+            model.model.layers[0].self_attn.qkv_proj.weight_scale_inv, scale
+        )
+
+
+@pytest.mark.parametrize("kind", ["weight", "weight_scale_inv"])
+def test_incomplete_fused_qkv_pair_fails_at_postload_not_partial_stream(
