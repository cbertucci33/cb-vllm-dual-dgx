+class ShutdownOrderingTests(unittest.TestCase):
+    def test_faulted_optional_connector_cannot_prevent_arena_owner_eviction(self):
+        path = ROOT / "vllm/v1/worker/gpu/model_runner.py"
+        tree = ast.parse(path.read_text())
