+
+    class FakeTrellis:
+        def __init__(self):
+            self.args = None
+            self.kwargs = None
+
+        def prepare_weights(self, *args, **kwargs):
+            self.args = args
+            self.kwargs = kwargs
+            return object()
+
+    api = FakeTrellis()
+    monkeypatch.setattr(exl3_module, "_load_sparkinfer_trellis", lambda: api)
