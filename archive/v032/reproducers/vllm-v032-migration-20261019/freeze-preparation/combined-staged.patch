+class InputBufferLifetime:
+    """Retire each rank's GPU readers before rotating host buffers are reused.
+
+    Output delivery still waits only for its D2H copy, so it can overlap
+    postprocessing and drafting. Their completion matters at buffer reuse.
+    """
+
+    def __init__(self, max_concurrent_batches: int):
+        # Match UvaBufferPool's minimum depth, including synchronous scheduling.
+        self.depth = max(2, max_concurrent_batches)
+        self._pending: deque[tuple[torch.cuda.Event, Any]] = deque()
+        self._active = False
+
+    def begin_step(self) -> None:
+        assert not self._active, "the previous input-buffer step was not sealed"
+        if len(self._pending) >= self.depth:
+            event, output = self._pending.popleft()
+            event.synchronize()
+            if output is not None:
+                output.copy_event.synchronize()
+        self._active = True
+
+    def end_step(
+        self,
+        main_stream: torch.cuda.Stream,
+        output: "AsyncOutput | AsyncPoolingOutput | None" = None,
+    ) -> None:
+        if not self._active:
+            # Dummy/capture executions do not rotate request-state pools.
+            return
+        event = torch.cuda.Event(blocking=True)
+        event.record(main_stream)
+        # Retain D2H sources even on TP ranks that do not return an RPC output.
+        self._pending.append((event, output))
+        self._active = False
+
+
