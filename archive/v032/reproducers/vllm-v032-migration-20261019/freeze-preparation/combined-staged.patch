+    group.logical_topk_indices = SimpleNamespace(shape=(1, 2048))
+    group.caches, group.prefill_ready_events = [], []
+    assert (
+        group.register_layer(object(), row_width=row_bytes, kv_cache_dtype="fp8_ds_mla")
+        == 0
