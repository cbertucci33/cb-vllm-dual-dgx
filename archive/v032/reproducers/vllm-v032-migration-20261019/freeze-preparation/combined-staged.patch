+    builder = triton.TritonAttentionDiffKVMetadataBuilder(
+        spec, [], _config(), torch.device("cpu")
+    )
+    assert len(allocations) == 1
+    assert allocations[0] is builder.softmax_segm_output
+    assert allocations[0].shape[-1] == head_size_v
