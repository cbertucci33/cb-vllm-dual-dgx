new file mode 100644
index 0000000000..c5661ef750
--- /dev/null
+++ b/tools/dflash_calibration/contract.py
@@ -0,0 +1,64 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Offline validation for fresh TP2 DFlash cache-write captures."""
+
+import hashlib
+import json
+import math
+
+PAIRS = {(rank, phase) for rank in (0, 1) for phase in ("context", "query")}
+STAGES = {"calibration", "heldout"}
+
+
+def validate_events(events, samples):
+    expected = {row["sample"]: row["stage"] for row in samples}
+    if len(expected) != len(samples) or set(expected.values()) != STAGES:
+        raise ValueError("Fixtures require unique samples in both stages")
+    seen = {}
+    for event in events:
+        sample = event["sample"]
+        if sample not in expected or event["stage"] != expected[sample]:
+            raise ValueError("Unexpected sample or stage")
+        fixture = next(row for row in samples if row["sample"] == sample)
+        if "request" in fixture:
+            expected_hash = hashlib.sha256(
+                json.dumps(fixture["request"], separators=(",", ":")).encode()
+            ).hexdigest()
+            if event["request_sha256"] != expected_hash:
+                raise ValueError("Capture request differs from pinned fixture")
+        layer = event["layer"]
+        if layer not in range(5) or (event["rank"], event["phase"]) not in PAIRS:
+            raise ValueError("Unexpected layer/rank/phase")
+        if event["rows"] <= 0 or event.get("provenance_version") != 2:
+            raise ValueError("Missing actual-row provenance")
+        if not event.get("request_sha256") or not event.get("capture_id"):
+            raise ValueError("Missing request/capture identity")
+        for kind in ("k", "v"):
+            maximum = event[kind + "_absmax"]
+            if not math.isfinite(maximum) or maximum < 0:
+                raise ValueError("Nonfinite activation maximum")
+        seen.setdefault((sample, layer), set()).add((event["rank"], event["phase"]))
+    for sample in expected:
+        for layer in range(5):
+            if seen.get((sample, layer)) != PAIRS:
+                raise ValueError(
+                    f"Incomplete sample {sample}, layer {layer} rank/phase coverage"
+                )
+    return seen
+
+
+def validate_rows(token_ids, positions, sequence_ids, slots):
+    count = len(slots)
+    if not count or any(len(x) != count for x in (token_ids, positions, sequence_ids)):
+        raise ValueError("Actual write rows lack aligned token/sequence provenance")
+    if any(slot < 0 for slot in slots):
+        raise ValueError("Padding/rejected rows entered calibration")
+    if any(not isinstance(token, int) or token < 0 for token in token_ids):
+        raise ValueError("Invalid rendered token IDs")
+    if any(not isinstance(pos, int) or pos < 0 for pos in positions):
+        raise ValueError("Invalid original positions")
+    if any(
+        not isinstance(seq, str) or not seq or seq == "padding" for seq in sequence_ids
+    ):
+        raise ValueError("Missing scheduled sequence owner")
diff --git a/tools/dflash_calibration/create_scales.py b/tools/dflash_calibration/create_scales.py
new file mode 100644
index 0000000000..7a09172388
--- /dev/null
+++ b/tools/dflash_calibration/create_scales.py
@@ -0,0 +1,204 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+import argparse
+import hashlib
+import json
+import math
+from pathlib import Path
+
+import numpy as np
+import torch
+from contract import validate_events, validate_rows
+from safetensors.torch import save_file
+
+parser = argparse.ArgumentParser()
+parser.add_argument("--root", type=Path, required=True)
+parser.add_argument("--source", required=True)
+parser.add_argument("--runtime-contract", type=Path, required=True)
+parser.add_argument("--capture-id", required=True)
+args = parser.parse_args()
+root = args.root
+runtime_hash = hashlib.sha256(args.runtime_contract.read_bytes()).hexdigest()
+rows = []
+for rank in (0, 1):
+    path = root / "capture" / f"node-{rank + 1}" / "events.jsonl"
+    events = [json.loads(line) for line in path.read_text().splitlines()]
+    if not events or not all(e["rank"] == rank for e in events):
+        raise ValueError("Empty/wrong-rank event stream")
+    for event in events:
+        event["_path"] = path.parent / event["tensor"]
+        rows.append(event)
+samples = json.loads((root / "requests-text-only.json").read_text())
+validate_events(rows, samples)
+for rank in (0, 1):
+    capture = root / "capture" / f"node-{rank + 1}"
+    if (capture / "active.json").exists() or list(capture.glob("inflight-*.json")):
+        raise ValueError("Capture still active; producer completion is required")
+    if list(capture.glob("producer-failed-*.json")):
+        raise ValueError("Producer failure invalidates this capture")
+    ready = json.loads((capture / "capture-ready.json").read_text())
+    if (
+        ready["rank"] != rank
+        or ready["source"] != args.source
+        or ready["capture_id"] != args.capture_id
+        or ready["runtime_contract_sha256"] != runtime_hash
+    ):
+        raise ValueError("Stale capture readiness identity")
+    for sample in samples:
+        finished = json.loads(
+            (capture / ("finished-" + sample["sample"] + ".json")).read_text()
+        )
+        if finished["capture_id"] != args.capture_id:
+            raise ValueError("Stale sample completion")
+for row in rows:
+    if (
+        row["capture_id"] != args.capture_id
+        or row["runtime_contract_sha256"] != runtime_hash
+    ):
+        raise ValueError("Stale tensor event")
+    tensor = torch.load(row["_path"], map_location="cpu", weights_only=True)
+    marker = tensor["marker"]
+    if (
+        marker["capture_id"] != args.capture_id
+        or marker["sample"] != row["sample"]
+        or marker["request_sha256"] != row["request_sha256"]
+    ):
+        raise ValueError("Tensor/event identity mismatch")
+    validate_rows(
+        tensor["token_ids"],
+        tensor["positions"].tolist(),
+        tensor["sequence_ids"],
+        tensor["slots"],
+    )
+    if (
+        len(tensor["token_ids"]) != row["rows"]
+        or tensor["rank"] != row["rank"]
+        or tensor["layer"] != row["layer"]
+        or tensor["phase"] != row["phase"]
+    ):
+        raise ValueError("Tensor/event row ownership mismatch")
+    boundaries = tensor.get("sequence_boundaries")
+    if not boundaries or not boundaries.get("query_start_loc"):
+        raise ValueError("Scheduled sequence boundaries are missing")
+    if any(tensor[key].shape != (row["rows"], 4, 128) for key in ("key", "value")):
+        raise ValueError("Draft TP2 K/V geometry differs from capture contract")
+    for kind, key in (("k", "key"), ("v", "value")):
+        x = tensor[key].float()
+        if not torch.isfinite(x).all():
+            raise ValueError("Nonfinite captured tensor")
+        if x.abs().max().item() != row[kind + "_absmax"]:
+            raise ValueError("Recorded maximum differs from actual tensor")
+coverage = {}
+scales = {}
+for layer in range(5):
+    group = [r for r in rows if r["layer"] == layer]
+    observed = {(r["rank"], r["phase"]) for r in group}
+    if observed != {(0, "context"), (0, "query"), (1, "context"), (1, "query")}:
+        raise ValueError(f"Missing rank/phase for layer {layer}")
+    training = [r for r in group if r["stage"] == "calibration"]
+    held = [r for r in group if r["stage"] == "heldout"]
+    if not training or not held:
+        raise ValueError("Both calibration and heldout stages are required")
+    coverage[str(layer)] = {
+        "phase_rank_coverage": sorted(observed),
+        "observations": len(group),
+        "rows": sum(r["rows"] for r in group),
+    }
+    for kind in ("k", "v"):
+        maximum = max(r[kind + "_absmax"] for r in training)
+        if not math.isfinite(maximum) or maximum <= 0:
+            raise ValueError("Scale requires a positive finite observed maximum")
+        value = np.nextafter(np.float32(maximum / 448.0), np.float32(np.inf)).item()
+        if not math.isfinite(value) or value <= 0:
+            raise ValueError("Invalid FP32 scale")
+        scales[f"layers.{layer}.self_attn.attn.{kind}_scale"] = torch.tensor(
+            value, dtype=torch.float32
+        )
+        coverage[str(layer)][kind] = {
+            "calibration_absmax": maximum,
+            "scale": value,
+            "heldout_absmax": max(r[kind + "_absmax"] for r in held),
+        }
+metrics = {}
+for layer in range(5):
+    for kind, key in (("k", "key"), ("v", "value")):
+        scale = scales[f"layers.{layer}.self_attn.attn.{kind}_scale"].item()
+        overflow = 0
+        count = 0
+        error2 = 0.0
+        signal2 = 0.0
+        maxerror = 0.0
+        for row in rows:
+            if row["layer"] != layer or row["stage"] != "heldout":
+                continue
+            x = torch.load(row["_path"], map_location="cpu", weights_only=True)[
+                key
+            ].float()
+            normalized = x / scale
+            overflow += int((normalized.abs() > 448).sum())
+            count += x.numel()
+            restored = (
+                normalized.clamp(-448, 448).to(torch.float8_e4m3fn).float() * scale
+            )
+            if not torch.isfinite(restored).all():
+                raise ValueError("Nonfinite heldout quantization")
+            difference = restored.double() - x.double()
+            error2 += difference.square().sum().item()
+            signal2 += x.double().square().sum().item()
+            maxerror = max(maxerror, difference.abs().max().item())
+        metrics[f"{layer}_{kind}"] = {
+            "values": count,
+            "out_of_range": overflow,
+            "relative_l2": (math.sqrt(error2 / signal2) if signal2 else 0.0),
+            "maximum_absolute_error": maxerror,
+        }
+if any(m["values"] <= 0 or m["out_of_range"] for m in metrics.values()):
+    raise ValueError("Heldout range validation failed; no scale artifact exported")
+if any(
+    not math.isfinite(value) for metric in metrics.values() for value in metric.values()
+):
+    raise ValueError("Nonfinite heldout metric; no artifact exported")
+out = root / "scale-candidate"
+out.mkdir(exist_ok=False)
+save_file(scales, str(out / "kv_cache_scales.safetensors"))
+provenance = {
+    "source_commit": args.source,
+    "capture_id": args.capture_id,
+    "runtime_contract_sha256": runtime_hash,
+    "target": "mimo-heretic-v031-mm-b12f5573",
+    "draft": "MiMo-V2.6-Flash-MOPD-DFlash-BF16-TP2-20261002",
+    "calibration": (
+        "fresh actual in-house cache writes; recorded runtime contract "
+        "determines dtype; context and query on TP2"
+    ),
+    "formula": "nextafter_float32(calibration_absmax/448,+infinity)",
+    "margin": (
+        "one upward float32 rounding step to avoid arithmetic undercoverage; "
+        "no inherited 1.1 factor"
+    ),
+    "Q_changes": False,
+    "old_captures_used": False,
+    "scale_count": len(scales),
+    "coverage": coverage,
+    "heldout_quantization_metrics": metrics,
+    "heldout_range_pass": all(m["out_of_range"] == 0 for m in metrics.values()),
+    "native_FP8_reload": "not executed",
+    "requests_sha256": hashlib.sha256(
+        (root / "requests-text-only.json").read_bytes()
+    ).hexdigest(),
+}
+(out / "KV_CACHE_CALIBRATION.json").write_text(
+    json.dumps(provenance, indent=2, allow_nan=False)
+)
+print(
+    json.dumps(
+        {
+            "scales": len(scales),
+            "heldout_range_pass": provenance["heldout_range_pass"],
+            "metrics": metrics,
+        },
+        indent=2,
+    )
+)
diff --git a/tools/dflash_calibration/draft_kv_capture.py b/tools/dflash_calibration/draft_kv_capture.py
new file mode 100644
index 0000000000..d73ac05ec9
--- /dev/null
+++ b/tools/dflash_calibration/draft_kv_capture.py
@@ -0,0 +1,328 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+import contextvars
+import functools
+import hashlib
+import inspect
+import json
+import os
+import sys
+from pathlib import Path
+
+import regex as re
+import torch
+from contract import validate_rows
+
+_batch = contextvars.ContextVar("draft_capture_batch", default=None)
+_context_rows = contextvars.ContextVar("draft_capture_context_rows", default=None)
+_query_rows = contextvars.ContextVar("draft_capture_query_rows", default=None)
+
+_phase = contextvars.ContextVar("draft_calibration_phase", default=None)
+_counter = 0
+
+
+def observe(layer, key, value, slots, marker, rank, root, phase):
+    global _counter
+    match = re.search(r"\.layers\.(\d+)\.self_attn\.attn$", layer.layer_name)
+    if match is None or not 48 <= int(match[1]) <= 52:
+        raise ValueError("Unexpected draft attention owner: " + layer.layer_name)
+    if phase is None or phase[0] not in ("context", "query"):
+        raise ValueError("Draft write lacks an explicit context/query owner")
+    # Native cache insertion owns slots.numel() rows; trailing model padding
+    # is not written and must not enter calibration.
+    rows = slots.numel()
+    if key.shape[0] < rows or value.shape[0] < rows:
+        raise ValueError("Calibration cannot ignore missing cache-write rows")
+    k = key[:rows].reshape(rows, 4, 128)
+    v = value[:rows].reshape(rows, 4, 128)
+    valid = slots.reshape(-1) >= 0
+    k = k[valid].detach().to("cpu").contiguous()
+    v = v[valid].detach().to("cpu").contiguous()
+    if not k.numel():
+        return
+    if not torch.isfinite(k).all() or not torch.isfinite(v).all():
+        raise ValueError("Fresh draft activation contains NaN/Inf")
+    positions = phase[1]
+    if positions.ndim != 1 or positions.numel() < rows:
+        raise ValueError("Fresh draft positions disagree with cache-write rows")
+    positions = positions[:rows][valid].detach().to("cpu")
+    owners = _context_rows.get() if phase[0] == "context" else _query_rows.get()
+    if owners is None:
+        raise ValueError("Cache write lacks scheduled token/sequence provenance")
+    token_ids, sequence_ids, boundaries = owners
+    selected = valid.detach().to("cpu").nonzero().reshape(-1).tolist()
+    token_ids = token_ids[:rows].detach().to("cpu")[selected].tolist()
+    sequence_ids = [sequence_ids[i] for i in selected]
+    actual_slots = slots.reshape(-1)[:rows][valid].detach().to("cpu").tolist()
+    validate_rows(token_ids, positions.tolist(), sequence_ids, actual_slots)
+    local_layer = int(match[1]) - 48
+    _counter += 1
+    name = (
+        f"{marker['sample']}-rank{rank}-layer{local_layer}-{phase[0]}-"
+        f"{os.getpid()}-{_counter}.pt"
+    )
+    path = root / name
+    if path.exists():
+        raise ValueError("Refusing to overwrite calibration capture")
+    torch.save(
+        {
+            "key": k,
+            "value": v,
+            "positions": positions,
+            "marker": marker,
+            "rank": rank,
+            "layer": local_layer,
+            "phase": phase[0],
+            "token_ids": token_ids,
+            "sequence_ids": sequence_ids,
+            "slots": actual_slots,
+            "sequence_boundaries": boundaries,
+            "provenance_version": 2,
+        },
+        path,
+    )
+    event = {
+        "tensor": name,
+        "rank": rank,
+        "layer": local_layer,
+        "phase": phase[0],
+        "stage": marker["stage"],
+        "sample": marker["sample"],
+        "rows": k.shape[0],
+        "k_absmax": k.float().abs().max().item(),
+        "v_absmax": v.float().abs().max().item(),
+        "positions_min": positions.min().item(),
+        "positions_max": positions.max().item(),
+        "request_sha256": marker["request_sha256"],
+        "capture_id": marker["capture_id"],
+        "runtime_contract_sha256": marker["runtime_contract_sha256"],
+        "provenance_version": 2,
+    }
+    with (root / "events.jsonl").open("a") as out:
+        out.write(json.dumps(event) + "\n")
+
+
+def install():
+    from vllm.distributed import get_tensor_model_parallel_rank
+    from vllm.model_executor.models.qwen3_dflash import (
+        DFlashQwen3Attention,
+        DFlashQwen3Model,
+    )
+    from vllm.v1.attention.backends.triton_attn import TritonAttentionImpl
+    from vllm.v1.worker.gpu.model_runner import GPUModelRunner
+    from vllm.v1.worker.gpu.spec_decode.dflash.speculator import DFlashSpeculator
+
+    root = Path(os.environ["MIMO_DFLASH_CALIBRATION_DIR"])
+    root.mkdir(parents=True, exist_ok=True)
+    marker_file = root / "active.json"
+    expected_rank = int(os.environ["MIMO_CALIBRATION_RANK"])
+    capture_id = os.environ["MIMO_CALIBRATION_CAPTURE_ID"]
+    runtime_hash = os.environ["MIMO_CALIBRATION_RUNTIME_SHA256"]
+    if len(runtime_hash) != 64:
+        raise ValueError("Exact runtime-definition SHA256 required")
+    if expected_rank not in (0, 1) or not capture_id:
+        raise ValueError("Explicit TP2 capture identity required")
+    original_write = TritonAttentionImpl.do_kv_cache_update
+    original_context = DFlashQwen3Model.precompute_and_store_context_kv
+    original_query = DFlashQwen3Attention.forward
+
+    def context(self, context_states, context_positions, context_slot_mapping=None):
+        token = _phase.set(("context", context_positions))
+        try:
+            return original_context(
+                self, context_states, context_positions, context_slot_mapping
+            )
+        finally:
+            _phase.reset(token)
+
+    def query(self, positions, hidden_states):
+        token = _phase.set(("query", positions))
+        try:
+            return original_query(self, positions, hidden_states)
+        finally:
+            _phase.reset(token)
+
+    def write(self, layer, key, value, kv_cache, slot_mapping):
+        if marker_file.exists():
+            if torch.cuda.is_current_stream_capturing():
+                raise RuntimeError("Calibration requires diagnostic eager execution")
+            rank = get_tensor_model_parallel_rank()
+            if rank != expected_rank:
+                raise ValueError("Calibration rank/host contract mismatch")
+            marker = json.loads(marker_file.read_text())
+            if (
+                marker["capture_id"] != capture_id
+                or marker["runtime_contract_sha256"] != runtime_hash
+            ):
+                raise ValueError("Stale calibration marker")
+            observe(layer, key, value, slot_mapping, marker, rank, root, _phase.get())
+        return original_write(self, layer, key, value, kv_cache, slot_mapping)
+
+    DFlashQwen3Model.precompute_and_store_context_kv = context
+    DFlashQwen3Attention.forward = query
+    TritonAttentionImpl.do_kv_cache_update = write
+    files = {}
+    for owner in (
+        DFlashQwen3Model,
+        DFlashQwen3Attention,
+        TritonAttentionImpl,
+        DFlashSpeculator,
+        GPUModelRunner,
+    ):
+        file = Path(inspect.getfile(owner))
+        files[str(file)] = hashlib.sha256(file.read_bytes()).hexdigest()
+    (root / f"instrumentation-{os.getpid()}.json").write_text(
+        json.dumps(
+            {
+                "rank": expected_rank,
+                "source": os.environ["MIMO_CALIBRATION_SOURCE"],
+                "instrumented_source_files": files,
+                "q_changes": False,
+                "capture_boundary": (
+                    "actual post-normalization/RoPE/V-multiplier cache write"
+                ),
+            },
+            indent=2,
+        )
+    )
+
+    original_propose = DFlashSpeculator.propose
+    original_precompute = DFlashSpeculator._precompute_context_kv
+    original_run = DFlashSpeculator._run_model
+    original_load = GPUModelRunner.load_model
+    propose_signature = inspect.signature(original_propose)
+
+    @functools.wraps(original_propose)
+    def propose(self, *args, **kwargs):
+        if not marker_file.exists():
+            return original_propose(self, *args, **kwargs)
+        bound = propose_signature.bind(self, *args, **kwargs)
+        bound.apply_defaults()
+        if bound.arguments["dummy_run"] or bound.arguments["is_profile"]:
+            raise ValueError("Warmup/profile cannot enter active calibration")
+        batch = bound.arguments["input_batch"]
+        if batch.num_reqs != 1:
+            raise ValueError("Calibration requires one isolated sequence")
+        marker = json.loads(marker_file.read_text())
+        if (
+            marker["capture_id"] != capture_id
+            or marker["runtime_contract_sha256"] != runtime_hash
+        ):
+            raise ValueError("Stale capture lease")
+        inflight = root / f"inflight-{os.getpid()}.json"
+        if inflight.exists():
+            raise ValueError("Unfinished producer lease")
+        inflight.write_text(json.dumps(marker))
+        token = _batch.set(batch)
+        try:
+            result = original_propose(self, *args, **kwargs)
+            receipt = dict(
+                marker,
+                rank=get_tensor_model_parallel_rank(),
+                req_ids=batch.req_ids,
+                status="producer_completed",
+            )
+            with (root / "producer-completions.jsonl").open("a") as out:
+                out.write(json.dumps(receipt) + "\n")
+            return result
+        except BaseException:
+            (root / f"producer-failed-{os.getpid()}.json").write_text(
+                json.dumps(marker)
+            )
+            raise
+        finally:
+            _batch.reset(token)
+            inflight.unlink()
+
+    @functools.wraps(original_precompute)
+    def precompute(self, start, end, dummy_run=False):
+        batch = _batch.get()
+        if batch is None:
+            return original_precompute(self, start, end, dummy_run)
+        boundaries = batch.query_start_loc_np.tolist()
+        sequences = [
+            req_id
+            for i, req_id in enumerate(batch.req_ids)
+            for _ in range(boundaries[i], boundaries[i + 1])
+        ]
+        if len(sequences) != batch.num_tokens:
+            raise ValueError("Scheduled target rows disagree with boundaries")
+        token = _context_rows.set(
+            (
+                batch.input_ids[start:end],
+                sequences[start:end],
+                dict(query_start_loc=boundaries, slice_start=start, slice_end=end),
+            )
+        )
+        try:
+            return original_precompute(self, start, end, dummy_run)
+        finally:
+            _context_rows.reset(token)
+
+    @functools.wraps(original_run)
+    def run(self, num_tokens, *args, **kwargs):
+        batch = _batch.get()
+        if batch is None:
+            return original_run(self, num_tokens, *args, **kwargs)
+        sequences = [
+            req_id for req_id in batch.req_ids for _ in range(self.num_query_per_req)
+        ]
+        # Slot filtering excludes padding, which has no sequence owner.
+        sequences += ["padding"] * (num_tokens - len(sequences))
+        token = _query_rows.set(
+            (
+                self.input_buffers.input_ids[:num_tokens],
+                sequences,
+                dict(
+                    query_start_loc=[
+                        i * self.num_query_per_req for i in range(batch.num_reqs + 1)
+                    ],
+                    slice_start=0,
+                    slice_end=num_tokens,
+                ),
+            )
+        )
+        try:
+            return original_run(self, num_tokens, *args, **kwargs)
+        finally:
+            _query_rows.reset(token)
+
+    @functools.wraps(original_load)
+    def load(self, *args, **kwargs):
+        config = self.vllm_config
+        if (
+            config.scheduler_config.async_scheduling is not False
+            or not config.model_config.enforce_eager
+            or config.scheduler_config.max_num_seqs != 1
+        ):
+            raise ValueError(
+                "Capture requires the explicit isolated eager/no-async contract"
+            )
+        result = original_load(self, *args, **kwargs)
+        rank = get_tensor_model_parallel_rank()
+        if rank != expected_rank:
+            raise ValueError("Loaded rank differs from capture contract")
+        receipt = dict(
+            rank=rank,
+            capture_id=capture_id,
+            runtime_contract_sha256=runtime_hash,
+            pid=os.getpid(),
+            capture_root=str(root),
+            executable=sys.executable,
+            boot_id=Path("/proc/sys/kernel/random/boot_id").read_text().strip(),
+            source=os.environ["MIMO_CALIBRATION_SOURCE"],
+            instrumented_source_files=files,
+            hook_sha256=hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+        )
+        path = root / "capture-ready.json"
+        if path.exists():
+            raise ValueError("Refusing stale readiness receipt")
+        path.write_text(json.dumps(receipt, indent=2))
+        return result
+
+    DFlashSpeculator.propose = propose
+    DFlashSpeculator._precompute_context_kv = precompute
+    DFlashSpeculator._run_model = run
+    GPUModelRunner.load_model = load
