+    # p=q=[1/8, 3/8, 1/2, 0, ...]. Width/extra zero-mass blocks may differ.
+    # All proposed tokens must be accepted, whatever their probability.
+    pv, qv = widths
+    p = torch.full((k + 1, pv), -float("inf"))
+    q = torch.full((1, k, qv), -float("inf"))
