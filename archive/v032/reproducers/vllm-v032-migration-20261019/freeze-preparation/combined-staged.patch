+def verify_flashinfer() -> None:
+    required = {
+        "query",
+        "kv_cache",
+        "workspace_buffer",
+        "qk_nope_head_dim",
+        "kv_lora_rank",
+        "qk_rope_head_dim",
+        "block_tables",
+        "seq_lens",
+        "max_seq_len",
