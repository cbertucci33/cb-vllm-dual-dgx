+class Source:
+    def __init__(self, fail_close=False, fail_read=False):
+        self.position = 0
+        self.closed = 0
+        self.fail_close = fail_close
+        self.fail_read = fail_read
+
+    def __iter__(self):
+        return self
+
+    def __next__(self):
+        if self.fail_read:
+            raise ValueError("read error")
+        if self.position == 2:
+            raise StopIteration
+        self.position += 1
+        return "weight" + str(self.position), object()
+
+    def close(self):
+        self.closed += 1
+        if self.fail_close:
+            raise RuntimeError("close error")
+
+
