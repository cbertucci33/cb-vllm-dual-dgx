new file mode 100644
index 0000000000..0fca2886ad
--- /dev/null
+++ b/build/provenance.py
@@ -0,0 +1,140 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+"""Emit source and toolchain provenance for the unified runner image."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import subprocess
+import sys
+from pathlib import Path
+
+
+def digest(path: Path) -> str:
+    hasher = hashlib.sha256()
+    with path.open("rb") as stream:
+        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
+            hasher.update(chunk)
+    return hasher.hexdigest()
+
+
+def main() -> None:
+    repo = Path(__file__).resolve().parent.parent
+    if len(sys.argv) != 6:
+        raise SystemExit(
+            "usage: provenance.py OUTPUT SOURCE_COMMIT BUILD_BASE FINAL_BASE CUDA_DEVEL"
+        )
+    output = Path(sys.argv[1]).resolve()
+    expected = sys.argv[2]
+    build_base_image, final_base_image, cuda_devel_image = sys.argv[3:]
+    versions: dict[str, str] = {}
+    for raw in (repo / "build/versions.env").read_text(encoding="utf-8").splitlines():
+        line = raw.strip()
+        if line and not line.startswith("#"):
+            key, value = line.split("=", 1)
+            versions[key] = value
+    commit = subprocess.check_output(
+        ["git", "-C", str(repo), "rev-parse", "HEAD"], text=True
+    ).strip()
+    if commit != expected:
+        raise SystemExit(
+            f"source HEAD is {commit}; requested source commit is {expected}"
+        )
+    status = subprocess.check_output(
+        ["git", "-C", str(repo), "status", "--porcelain", "--untracked-files=all"],
+        text=True,
+    )
+    if status:
+        raise SystemExit("source tree must be clean, including untracked files")
+    diff = subprocess.check_output(
+        ["git", "-C", str(repo), "diff", "--binary", "HEAD"],
+    )
+    source_inputs = [
+        repo / ".dockerignore",
+        repo / ".gitignore",
+        repo / "CMakeLists.txt",
+        repo / "docker/Dockerfile",
+        repo / "requirements/cuda.txt",
+        repo / "requirements/common.txt",
+        repo / "build/versions.env",
+        repo / "build/media-requirements.txt",
+        repo / "build/assets/glm53/chat_template.jinja",
+        repo / "build/fetch_sources.sh",
+        repo / "build/verify_runtime.py",
+        repo / "build/build_flashinfer_topk.py",
+        repo / "build/reconcile_torch_nccl_metadata.py",
+        repo / "build/build_instanttensor.py",
+        repo / "build/patches/instanttensor-0.2.2-cleanup.patch",
+        repo / "build/patches/instanttensor-0.2.2-startup-safety.patch",
+        repo / "build/patches/exllamav3-startup-safety.patch",
+        repo / "build/patches/exllamav3-aarch64.patch",
+        repo / "build/patches/sparkinfer-cutlass-dsl.patch",
+        repo / "build/patches/sparkinfer-trellis-swiglu-limit.patch",
+        repo / "build/patches/sparkinfer-trellis-barrier-order.patch",
+        repo / "build/patches/flashinfer-sm120-memory-order.patch",
+        repo / "build/patches/transformers-glm5next-temporal-budget.patch",
+        repo / "build/patches/b12x-cutlass-dsl.patch",
+        repo / "build/profiles/nvidia.gb10.48sm.json.gz",
+        repo / "build/profiles/nvidia.gb10.48sm.evidence.json.gz",
+        repo / "build/provenance.py",
+        repo / "build/Dockerfile.runner",
+        repo / "build/build_image.sh",
+    ]
+    result = {
+        "schema_version": 1,
+        "source": {"vllm_version": versions["VLLM_VERSION"], "vllm_commit": commit},
+        "images": {
+            "official_source_build": (
+                f"vllm/vllm-openai:v{versions['VLLM_VERSION']} (built from source)"
+            ),
+            "build_base": build_base_image,
+            "final_base": final_base_image,
+            "cuda_devel": cuda_devel_image,
+        },
+        "platform": {
+            "os": "linux",
+            "architecture": "arm64",
+            "cuda_arch": versions["TORCH_CUDA_ARCH_LIST"],
+            "flashinfer_cuda_arch": versions["FLASHINFER_CUDA_ARCH_LIST"],
+            "vllm_dgx_sm121_only": versions["VLLM_DGX_SM121_ONLY"] == "ON",
+        },
+        "versions": {
+            key: value
+            for key, value in versions.items()
+            if key.endswith("_VERSION")
+            or key
+            in {
+                "CUDA_VERSION",
+                "PYTHON_VERSION",
+                "TORCH_VERSION",
+                "NCCL_VERSION",
+                "TRITON_VERSION",
+            }
+        },
+        "native_revisions": {
+            key.removesuffix("_COMMIT").lower(): value
+            for key, value in versions.items()
+            if key.endswith("_COMMIT")
+        },
+        "input_sha256": {
+            str(path.relative_to(repo)): digest(path) for path in source_inputs
+        },
+        "git_diff_sha256": hashlib.sha256(diff).hexdigest(),
+        "build_environment": {
+            "max_jobs": versions["MAX_JOBS"],
+            "vllm_core_max_jobs": versions["VLLM_CORE_MAX_JOBS"],
+            "nvcc_threads": versions["NVCC_THREADS"],
+        },
+        "model_artifacts": [],
+    }
+    output.parent.mkdir(parents=True, exist_ok=True)
+    output.write_text(
+        json.dumps(result, indent=2, sort_keys=True) + "\n", encoding="utf-8"
+    )
+
+
+if __name__ == "__main__":
+    main()
diff --git a/build/reconcile_torch_nccl_metadata.py b/build/reconcile_torch_nccl_metadata.py
new file mode 100755
index 0000000000..f066e52b93
--- /dev/null
+++ b/build/reconcile_torch_nccl_metadata.py
@@ -0,0 +1,116 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+"""Reconcile audited dependency metadata with the installed ARM64 runtime."""
+
+from __future__ import annotations
+
+import argparse
+import base64
+import csv
+import hashlib
+import io
+import re
+from importlib import metadata
+from pathlib import Path
+
+from packaging.tags import parse_tag, sys_tags
+
+
+def _record_hash(payload: bytes) -> str:
+    digest = base64.urlsafe_b64encode(hashlib.sha256(payload).digest()).rstrip(b"=")
+    return "sha256=" + digest.decode("ascii")
+
+
+def _update_record(dist: metadata.Distribution, path: Path, payload: bytes) -> None:
+    record_path = Path(dist._path) / "RECORD"
+    site_root = Path(dist.locate_file("")).resolve()
+    record_key = path.resolve().relative_to(site_root).as_posix()
+    rows = list(csv.reader(record_path.read_text(encoding="utf-8").splitlines()))
+    matches = 0
+    for row in rows:
+        if row and row[0] == record_key:
+            row[1] = _record_hash(payload)
+            row[2] = str(len(payload))
+            matches += 1
+    if matches != 1:
+        raise RuntimeError(
+            f"expected one RECORD entry for {record_key}, found {matches}"
+        )
+    output = io.StringIO(newline="")
+    csv.writer(output, lineterminator="\n").writerows(rows)
+    record_path.write_text(output.getvalue(), encoding="utf-8")
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--nccl-version", required=True)
+    parser.add_argument("--cusparselt-version", required=True)
+    args = parser.parse_args()
+
+    installed_nccl = metadata.version("nvidia-nccl-cu13")
+    if installed_nccl != args.nccl_version:
+        raise RuntimeError(
+            f"installed NCCL distribution is {installed_nccl}; "
+            f"expected {args.nccl_version}"
+        )
+    installed_cusparselt = metadata.version("nvidia-cusparselt-cu13")
+    if installed_cusparselt != args.cusparselt_version:
+        raise RuntimeError(
+            f"installed cuSPARSELt distribution is {installed_cusparselt}; "
+            f"expected {args.cusparselt_version}"
+        )
+
+    torch_dist = metadata.distribution("torch")
+    dist_info = Path(torch_dist._path)
+    metadata_path = dist_info / "METADATA"
+    original = metadata_path.read_text(encoding="utf-8")
+    replacement = rf"\g<1>{args.nccl_version}\g<2>"
+    updated, count = re.subn(
+        r"(?m)^(Requires-Dist: nvidia-nccl-cu13==)[^;]+(;.*)$",
+        replacement,
+        original,
+    )
+    if count != 1:
+        raise RuntimeError(f"expected one Torch NCCL requirement, found {count}")
+    metadata_bytes = updated.encode("utf-8")
+    metadata_path.write_bytes(metadata_bytes)
+
+    _update_record(torch_dist, metadata_path, metadata_bytes)
+
+    reconciled = next(
+        requirement
+        for requirement in metadata.distribution("torch").requires or ()
+        if requirement.startswith("nvidia-nccl-cu13==")
+    )
+    expected = f'nvidia-nccl-cu13=={args.nccl_version}; platform_system == "Linux"'
+    if reconciled != expected:
+        raise RuntimeError(
+            f"Torch NCCL metadata is {reconciled!r}; expected {expected!r}"
+        )
+    cusparselt_dist = metadata.distribution("nvidia-cusparselt-cu13")
+    wheel_path = Path(cusparselt_dist._path) / "WHEEL"
+    wheel_text = wheel_path.read_text(encoding="utf-8")
+    bad_tag = "Tag: py3-none-manylinux2014_sbsa"
+    good_tag = "Tag: py3-none-manylinux2014_aarch64"
+    if wheel_text.count(bad_tag) != 1:
+        raise RuntimeError(
+            "cuSPARSELt WHEEL does not contain exactly one incorrect SBSA tag"
+        )
+    wheel_bytes = wheel_text.replace(bad_tag, good_tag).encode("utf-8")
+    wheel_path.write_bytes(wheel_bytes)
+    _update_record(cusparselt_dist, wheel_path, wheel_bytes)
+
+    supported_tags = set(sys_tags())
+    corrected_tags = parse_tag("py3-none-manylinux2014_aarch64")
+    if corrected_tags.isdisjoint(supported_tags):
+        raise RuntimeError(
+            "corrected cuSPARSELt wheel tag is not supported by this runtime"
+        )
+    if bad_tag in wheel_path.read_text(encoding="utf-8"):
+        raise RuntimeError("cuSPARSELt WHEEL still advertises the SBSA tag")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/build/tests/native_cleanup_contract.cpp b/build/tests/native_cleanup_contract.cpp
new file mode 100644
index 0000000000..4b9cbe9453
--- /dev/null
+++ b/build/tests/native_cleanup_contract.cpp
@@ -0,0 +1,108 @@
+#include <instant_tensor/loader.hpp>
+#include <cassert>
+#include <algorithm>
+#include <cerrno>
+using namespace instanttensor;
+static std::vector<std::string> releases;
+static int failures = 0;
+static void* host_pointer = nullptr;
+extern "C" void __real_free(void*);
+extern "C" void __wrap_free(void* pointer) {
+  if (pointer && pointer == host_pointer) {
+    releases.push_back("host-free");
+    host_pointer = nullptr;
+  }
+  __real_free(pointer);
+}
+static cudaError_t allocate(void** pointer, size_t size) {
+  *pointer = std::malloc(size);
+  return cudaSuccess;
+}
+static cudaError_t release_device(void* pointer) {
+  releases.push_back("device-free");
+  std::free(pointer);
+  return failures & 4 ? static_cast<cudaError_t>(704) : cudaSuccess;
+}
+static cudaError_t register_host(void* pointer, size_t, unsigned int) {
+  host_pointer = pointer;
+  return cudaSuccess;
+}
+static cudaError_t unregister_host(void*) {
+  releases.push_back("host-unregister");
+  return failures & 8 ? static_cast<cudaError_t>(708) : cudaSuccess;
+}
+static cudaError_t destroy_stream(cudaStream_t stream) {
+  int id = static_cast<int>(reinterpret_cast<uintptr_t>(stream));
+  releases.push_back("stream" + std::to_string(id));
+  return failures & id ? static_cast<cudaError_t>(700 + id) : cudaSuccess;
+}
+static const char* error_text(cudaError_t) { return "injected CUDA failure"; }
+int main(int argc, char** argv) {
+  failures = argc > 1 ? std::atoi(argv[1]) : 0;
+  cuda_binding::cudaMalloc_fn = allocate;
+  cuda_binding::cudaFree_fn = release_device;
+  cuda_binding::cudaHostRegister_fn = register_host;
+  cuda_binding::cudaHostUnregister_fn = unregister_host;
+  cuda_binding::cudaStreamDestroy_fn = destroy_stream;
+  cuda_binding::cudaGetErrorString_fn = error_text;
+  auto input = std::make_unique<SPSCQueue<RPCRequest>>();
+  auto output = std::make_shared<SPSCQueue<RPCResponse>>();
+  Loader loader(std::move(input), output);
+  loader.backend = Backend::AIO;
+  loader.world_size = 1;
+  loader.rank_chunk_size = PAGE_SIZE;
+  loader.io_depth = 1;
+  loader.need_host_buffer = true;
+  loader.init_buffer();
+  loader.initialize_aio_context();
+  loader.cuda_stream = reinterpret_cast<void*>(1);
+  loader.nccl_stream = reinterpret_cast<void*>(2);
+  int pipe_fds[2];
+  assert(pipe(pipe_fds) == 0);
+  FileInfo file;
+  file.fd = pipe_fds[0];
+  loader.file_info.push_back(file);
+  std::string first_error;
+  try {
+    loader.close(CloseArgs{});
+  } catch (const std::exception& error) {
+    first_error = error.what();
+  }
+  const std::vector<std::string> expected = {
+      "stream1", "stream2", "device-free", "host-unregister", "host-free"};
+  assert(releases == expected);
+  assert(loader.threads_joined);
+  assert(loader.device_buffer == nullptr);
+  assert(loader.host_buffer_entry.ptr == nullptr);
+  errno = 0;
+  assert(fcntl(pipe_fds[0], F_GETFD) == -1 && errno == EBADF);
+  close(pipe_fds[1]);
+  if (!failures)
+    assert(first_error.empty());
+  else {
+    int expected_code = failures & 1   ? 701
+                        : failures & 2 ? 702
+                        : failures & 4 ? 704
+                                       : 708;
+    assert(first_error.find(std::to_string(expected_code)) !=
+           std::string::npos);
+  }
+  // Mapped-file cleanup must close its fd even when unregister fails.
+  loader.use_internal_memory_register = true;
+  assert(pipe(pipe_fds) == 0);
+  file.fd = pipe_fds[0];
+  file.mapped_memory = mmap(nullptr, PAGE_SIZE, PROT_READ | PROT_WRITE,
+                            MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+  assert(file.mapped_memory != MAP_FAILED);
+  file.size = PAGE_SIZE;
+  try {
+    loader.close_file_inmem(file);
+  } catch (const std::exception&) {
+    assert(failures & 8);
+  }
+  errno = 0;
+  assert(fcntl(pipe_fds[0], F_GETFD) == -1 && errno == EBADF);
+  close(pipe_fds[1]);
+  std::cout << "PASS fault-mask=" << failures
+            << " releases=5 first-error-preserved=1 fd-closed=1\n";
+}
diff --git a/build/tests/rpc_cleanup_contract.cpp b/build/tests/rpc_cleanup_contract.cpp
new file mode 100644
index 0000000000..e1bb0a5a8f
--- /dev/null
+++ b/build/tests/rpc_cleanup_contract.cpp
@@ -0,0 +1,26 @@
+#include "main.cpp"
+#include <cassert>
+int main() {
+  using namespace instanttensor;
+  LoaderManager rpc_manager;
+  auto input = std::make_unique<SPSCQueue<RPCRequest>>();
+  auto output = std::make_shared<SPSCQueue<RPCResponse>>();
+  rpc_manager.loader_handle_to_queue[41] = RPCHandle{0, input.get(), output};
+  std::thread responder([&] {
+    RPCRequest request;
+    input->pop(request);
+    assert(request.op == CLOSE);
+    auto error = std::make_exception_ptr(std::runtime_error("cleanup failure"));
+    output->push(RPCResponse{request.id, std::any(error)});
+  });
+  bool received_error = false;
+  try {
+    rpc_manager.close(41);
+  } catch (const std::exception& error) {
+    received_error = std::string(error.what()) == "cleanup failure";
+  }
+  responder.join();
+  assert(received_error);
+  assert(rpc_manager.loader_handle_to_queue.empty());
+  std::cout << "PASS CLOSE error reply consumed; handle registry erased\n";
+}
