+class FakeDevice:
+    def __init__(self, value):
+        text = str(value)
+        self.type = text.split(":")[0]
+        self.index = int(text.split(":")[1]) if ":" in text else None
+
+    def __str__(self):
+        return self.type if self.index is None else f"{self.type}:{self.index}"
