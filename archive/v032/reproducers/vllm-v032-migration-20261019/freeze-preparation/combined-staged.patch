+):
+    model = _minimal_loading_model(monkeypatch)
+    prefix = "model.layers.0.self_attn.qkv_proj"
+    values = {
+        "weight": torch.ones(384, 128).to(FP8_DTYPE),
+        "weight_scale_inv": torch.ones(3, 1),
+    }
+    model.load_weights([(prefix + "." + kind, values[kind])])
+    with pytest.raises(ValueError, match="Incomplete MiMo FP8 QKV pairs"):
+        _finalize_loading(model)
+    other = "weight_scale_inv" if kind == "weight" else "weight"
+    model.load_weights([(prefix + "." + other, values[other])])
+    _finalize_loading(model)
