@@ -0,0 +1,117 @@
+import gzip
+import json
+import unittest
+from pathlib import Path
+
+from flight_recorder import StreamSummary, summarize_json
+
+
+def event(summary, kind, observed_ns=10, **fields):
+    wire = ('data: ' + json.dumps({'type': kind, **fields}, ensure_ascii=False) + '\n\n').encode()
+    # Fragment Unicode and SSE lines, as real TCP streams may do.
+    for start in range(0, len(wire), 7):
+        summary.feed(wire[start:start + 7], observed_ns=observed_ns)
+
+
+class ResponsesSummaryTests(unittest.TestCase):
+    def test_parts_and_terminal_reconciliation_without_double_counting(self):
+        s = StreamSummary()
+        event(s, 'response.output_item.added', output_index=0, item={'id': 'r1', 'type': 'reasoning'})
+        event(s, 'response.reasoning_text.delta', 20, output_index=0, content_index=0, item_id='r1', delta='think')
+        event(s, 'response.reasoning_summary_text.delta', 25, output_index=0, summary_index=0, item_id='r1', delta='brief')
+        event(s, 'response.output_item.added', output_index=1, item={'id': 'm1', 'type': 'message'})
+        event(s, 'response.output_text.delta', 30, output_index=1, content_index=0, item_id='m1', delta='hi')
+        event(s, 'response.output_text.delta', 31, output_index=1, content_index=1, item_id='m1', delta='🙂')
+        output = [
+            {'id': 'r1', 'type': 'reasoning', 'content': [{'type': 'reasoning_text', 'text': 'think'}], 'summary': [{'type': 'summary_text', 'text': 'brief'}]},
+            {'id': 'm1', 'type': 'message', 'content': [{'type': 'output_text', 'text': 'hi'}, {'type': 'output_text', 'text': '🙂'}]},
+        ]
+        for i, item in enumerate(output):
+            event(s, 'response.output_item.done', output_index=i, item=item)
+        event(s, 'response.completed', response={'id': 'resp1', 'status': 'completed', 'output': output})
+        result = s.as_dict()
+        self.assertEqual((result['content_chars'], result['reasoning_chars'], result['reasoning_summary_chars']), (3, 5, 5))
+        self.assertEqual((s.first_reasoning_ns, s.first_answer_ns), (20, 30))
+        self.assertEqual(result['content_anomalies'], [])
+        self.assertEqual(result['response_output_types'], {'message': 1, 'reasoning': 1})
+
+    def test_parallel_function_and_custom_tools_keep_both_identities(self):
+        s = StreamSummary()
+        items = [
+            {'type': 'function_call', 'id': 'fc1', 'call_id': 'call1', 'name': 'read'},
+            {'type': 'custom_tool_call', 'id': 'ct2', 'call_id': 'call2', 'name': 'shell'},
+        ]
+        for i, item in enumerate(items):
+            event(s, 'response.output_item.added', output_index=i, item=item)
+        event(s, 'response.function_call_arguments.delta', output_index=0, item_id='fc1', delta='{"a":')
+        event(s, 'response.custom_tool_call_input.delta', output_index=1, item_id='ct2', delta='echo hi')
+        event(s, 'response.function_call_arguments.delta', output_index=0, item_id='fc1', delta='1}')
+        items[0]['arguments'] = '{"a":1}'
+        items[1]['input'] = 'echo hi'
+        for i, item in enumerate(items):
+            event(s, 'response.output_item.done', output_index=i, item=item)
+        event(s, 'response.completed', response={'status': 'completed', 'output': items})
+        calls = s.as_dict()['tool_calls']
+        self.assertEqual([(c['id'], c['call_id']) for c in calls], [('fc1', 'call1'), ('ct2', 'call2')])
+        self.assertEqual([c['argument_chars'] for c in calls], [7, 7])
+        self.assertEqual([c['arguments_json_valid'] for c in calls], [True, None])
+        self.assertEqual(s.as_dict()['tool_fragments'], 3)
+        self.assertEqual(s.as_dict()['content_anomalies'], [])
+
+    def test_terminal_only_and_nonstreaming_fallback(self):
+        response = {'object': 'response', 'id': 'r', 'status': 'completed', 'output': [
+            {'type': 'reasoning', 'id': 'rs', 'content': [{'type': 'reasoning_text', 'text': 'why'}]},
+            {'type': 'message', 'id': 'msg', 'content': [{'type': 'output_text', 'text': 'answer'}]},
+            {'type': 'function_call', 'id': 'fc', 'call_id': 'call', 'name': 'f', 'arguments': '{}'},
+        ]}
+        s = StreamSummary()
+        event(s, 'response.completed', response=response)
+        result = summarize_json(json.dumps(response).encode())
+        self.assertEqual((result['content_chars'], result['reasoning_chars']), (6, 3))
+        self.assertEqual(result['tool_calls'][0]['call_id'], 'call')
+        self.assertEqual(result['tool_calls'], s.as_dict()['tool_calls'])
+        self.assertIsNone(s.first_answer_ns)  # Terminal arrival is not generation time.
+
+    def test_empty_silent_reasoning_tools_and_marker_semantics(self):
+        cases = [
+            ([], []),
+            ([{'type': 'reasoning', 'content': [{'text': 'thinking'}]}], []),
+            ([{'type': 'message', 'content': []}], ['empty_completed_message']),
+            ([{'type': 'message', 'content': []}, {'type': 'web_search_call', 'id': 'web'}], []),
+            ([{'type': 'message', 'content': []}, {'type': 'function_call', 'call_id': 'c', 'arguments': '{}'}], []),
+            ([{'type': 'message', 'content': [{'type': 'refusal', 'refusal': 'Cannot do that'}]}], []),
+            ([{'type': 'message', 'content': [{'text': '</｜end▁of▁thinking｜>'}]}], ['reasoning_marker_only_answer']),
+            ([{'type': 'message', 'content': [{'text': 'Quoted </｜end▁of▁thinking｜> here.'}]}], []),
+        ]
+        for output, expected in cases:
+            with self.subTest(output=output):
+                result = summarize_json(json.dumps({'object': 'response', 'status': 'completed', 'output': output}).encode())
+                self.assertEqual(result['content_anomalies'], expected)
+
+    def test_saved_five_captures_against_completed_items(self):
+        root = Path('/opt/project/model-flight-recorder-data/proxy/captures/20261020')
+        ids = ['e76811c37596476a9928c3c440b28f00', '9a75b923484f4a86a470d61a39bffaf0', '86db7d1e9f7942d8acb04683312e842d', '41d565994bb54a7ba0c53ae8c823cffa', '004fb674040a47399078487eed43a557']
+        if not root.exists():
+            self.skipTest('Private captures remain on their source host')
+        for trace in ids:
+            with self.subTest(trace=trace):
+                with gzip.open(root / (trace + '.response.gz'), 'rb') as capture:
+                    raw = capture.read()
+                s = StreamSummary()
+                for i in range(0, len(raw), 997):
+                    s.feed(raw[i:i + 997])
+                s.finish()
+                terminal = next(json.loads(line[5:])['response'] for line in raw.splitlines() if line.startswith(b'data:') and b'response.completed' in line)
+                expected = {'message': 0, 'reasoning': 0}
+                for item in terminal['output']:
+                    if item['type'] in expected:
+                        expected[item['type']] += sum(len(part.get('text', '')) for part in item.get('content', []))
+                result = s.as_dict()
+                self.assertEqual(result['content_chars'], expected['message'])
+                self.assertEqual(result['reasoning_chars'], expected['reasoning'])
+                self.assertEqual(result['content_anomalies'], ['reasoning_marker_only_answer'] if trace == ids[0] else [])
+                self.assertIsNone(s.first_answer_ns)
+
+
+if __name__ == '__main__':
+    unittest.main()
